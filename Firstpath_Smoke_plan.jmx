            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor- GLOBAL_JWT_Token" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// 1. Correctly retrieve the token using the variable name set by the JSON Extractor
def tokenValue = vars.get(&quot;JWT_Token&quot;); 

// 2. ONLY proceed if the token was successfully extracted (to prevent the NullPointerException)
if (tokenValue != null &amp;&amp; !tokenValue.isEmpty()) {
    // 3. Set the value as a GLOBAL PROPERTY for use by all other Thread Groups
    props.put(&quot;GLOBAL_JWT_Token&quot;, tokenValue);
    log.info(&quot;Successfully set GLOBAL_JWT_Token: &quot; + tokenValue);
} else {
    log.error(&quot;Failed to extract JWT_Token in Thread Group 1. Global token not set.&quot;);
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
