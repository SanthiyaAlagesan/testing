            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Calendar;

synchronized (this.getClass()) {
    // 1. Fetch active runCounter (subtract 1 because Add Treatment already incremented it)
    String counterStr = props.get(&quot;RUN_COUNTER&quot;);
    int currentRun = (counterStr != null) ? Integer.parseInt(counterStr) - 1 : 1;
    if (currentRun &lt; 1) currentRun = 1;

    // 2. Base Start Date: January 1, 2030
    Calendar startCal = Calendar.getInstance();
    startCal.set(Calendar.YEAR, 2030);
    startCal.set(Calendar.MONTH, Calendar.JANUARY);
    startCal.set(Calendar.DAY_OF_MONTH, 1);
    
    // Add 3 months per run counter
    startCal.add(Calendar.MONTH, (currentRun - 1) * 3);

    // 3. Calculate End Date (Last day of the 3rd month)
    Calendar endCal = (Calendar) startCal.clone();
    endCal.add(Calendar.MONTH, 2); 
    int lastDay = endCal.getActualMaximum(Calendar.DAY_OF_MONTH);
    endCal.set(Calendar.DAY_OF_MONTH, lastDay);

    // 4. Calculate Schedule Date (15th day of the END MONTH of the authorization)
    Calendar schedCal = (Calendar) endCal.clone();
    schedCal.set(Calendar.DAY_OF_MONTH, 15);

    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
    String startDate = sdf.format(startCal.getTime());
    String endDate = sdf.format(endCal.getTime());
    String scheduleDate = sdf.format(schedCal.getTime());

    // Save variables for request body
    vars.put(&quot;startDate&quot;, startDate);
    vars.put(&quot;endDate&quot;, endDate);
    vars.put(&quot;scheduleDate&quot;, scheduleDate);

    log.info(&quot;--- [ADD SCHEDULE] Run #&quot; + currentRun + &quot; | Start: &quot; + startDate + &quot; | End: &quot; + endDate + &quot; | Schedule: &quot; + scheduleDate + &quot; ---&quot;);
    
    // Note: RUN_COUNTER is NOT incremented here
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion" enabled="true">
              <stringProp name="BeanShellAssertion.query">// Skip any sampler containing &quot;Debug Sampler&quot; in its name
if (prev.getSampleLabel().contains(&quot;Debug Sampler&quot;)) {
    return;
}

String responseCode = prev.getResponseCode();

// Ignore samplers that don&apos;t generate standard HTTP response codes (like Debug Samplers)
if (responseCode == null || responseCode.isEmpty()) {
    return;
}

// Log custom failure message for HTTP requests
String responseData = prev.getResponseDataAsString();

if (!&quot;200&quot;.equals(responseCode)) {
    String conciseReason = &quot;&quot;;
    if (responseData.length() &gt; 150) {
        conciseReason = responseData.substring(0, 150) + &quot;...&quot;;
    } else {
        conciseReason = responseData;
    }
    
    String finalMsg = &quot;Failed [Code: &quot; + responseCode + &quot;] - Reason: &quot; + conciseReason;
    prev.setResponseMessage(finalMsg);
    prev.setSuccessful(false);
    Failure = true;
    FailureMessage = finalMsg;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
            <hashTree/>
