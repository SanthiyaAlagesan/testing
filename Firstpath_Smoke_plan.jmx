          <hashTree>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import java.io.*;

// Synchronize so multiple JMeter threads don&apos;t corrupt the file during concurrent runs
synchronized (this.getClass()) {
    File file = new File(&quot;last_goal_number.txt&quot;);
    int goalNumber = 7002; // Updated starting baseline number

    if (file.exists() &amp;&amp; file.length() &gt; 0) {
        BufferedReader reader = null;
        try {
            reader = new BufferedReader(new FileReader(file));
            String line = reader.readLine();
            if (line != null) {
                // Strip non-numeric characters (prevents hidden formatting errors)
                String sanitized = line.replaceAll(&quot;[^0-9]&quot;, &quot;&quot;).trim();
                if (!sanitized.isEmpty()) {
                    goalNumber = Integer.parseInt(sanitized);
                }
            }
        } catch (Exception e) {
            log.error(&quot;Failed to read goal number file, defaulting to baseline: &quot; + e.getMessage());
        } finally {
            if (reader != null) {
                reader.close();
            }
        }
    }

    // Auto-increment by 1
    goalNumber = goalNumber + 1;

    // Save updated goal number back to the file
    FileWriter writer = new FileWriter(file, false);
    try {
        writer.write(String.valueOf(goalNumber));
    } finally {
        writer.close();
    }

    // Store variable for JMeter payload
    vars.put(&quot;goalNumber&quot;, String.valueOf(goalNumber));
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// File to store the counter
File goalFile = new File(&quot;goal_number_tracker.txt&quot;)
int currentGoalNumber = 7000 // Default initial starting goal number

// Thread-safe block to prevent file corruption during multi-thread execution
synchronized (this) {
    if (goalFile.exists()) {
        String fileText = goalFile.text.trim()
        // isInteger() is used instead of deprecated isNumber()
        if (fileText.isInteger()) {
            currentGoalNumber = fileText.toInteger() + 1
        }
    }

    // Save the updated number to file for the next run
    goalFile.setText(currentGoalNumber.toString(), &quot;UTF-8&quot;)
}

// Set the variable for your HTTP request payload ${goalNumber}
vars.put(&quot;goalNumber&quot;, currentGoalNumber.toString())

log.info(&quot;&gt;&gt;&gt; Generated Goal Number: ${currentGoalNumber}&quot;)</stringProp>
            </JSR223PostProcessor>
