ialCount&quot;:0,&quot;Progress&quot;:0,&quot;LastPerformedDate&quot;:null,&quot;Status&quot;:1,&quot;TotalPerformedDays&quot;:0,&quot;SelectedTargets&quot;:[],&quot;PerformedDates&quot;:[],&quot;TargetCountForCompletion&quot;:2,&quot;CompletedTargets&quot;:[],&quot;BehaviourDataWithDates&quot;:[]},{&quot;_id&quot;:&quot;&quot;,&quot;Title&quot;:&quot;Intermediate- Term Goal Status&quot;,&quot;StartDate&quot;:&quot;2025-11-12&quot;,&quot;EndDate&quot;:&quot;2025-12-23&quot;,&quot;Description&quot;:&quot;&lt;p&gt;J meter logs&lt;br&gt;&lt;/p&gt;&quot;,&quot;ShortSummary&quot;:&quot;J meter logs&quot;,&quot;DaysForAnalysis&quot;:1,&quot;CompletionPercentage&quot;:80,&quot;TotalProgress&quot;:0,&quot;TotalTrialCount&quot;:0,&quot;Progress&quot;:0,&quot;LastPerformedDate&quot;:null,&quot;Status&quot;:1,&quot;TotalPerformedDays&quot;:0,&quot;SelectedTargets&quot;:[],&quot;PerformedDates&quot;:[],&quot;TargetCountForCompletion&quot;:2,&quot;CompletedTargets&quot;:[],&quot;BehaviourDataWithDates&quot;:[]}],&quot;TargetSuccessCriteria&quot;:1,&quot;ReportObjectiveDetails&quot;:{&quot;ChildAuthReportId&quot;:null,&quot;ChildAuthorizationId&quot;:null,&quot;IsReportEdit&quot;:false,&quot;IsReportCreated&quot;:false,&quot;CompletedReportObjectiveDetails&quot;:null},&quot;BaselineTarget&quot;:12,&quot;BaselinePercentage&quot;:80,&quot;BaselineFrequency&quot;:null,&quot;TargetCountForCompletion&quot;:2,&quot;DurationOfBehaviour&quot;:null,&quot;FrequencyOfBehaviour&quot;:null,&quot;SkillObjectiveCompletionCriteriaType&quot;:1,&quot;BehaviourObjectiveCompletionCriteriaType&quot;:[],&quot;IsMovedtoNxtAuth&quot;:false,&quot;MeasurementType&quot;:null,&quot;MeasurementNumber&quot;:null}</stringProp>
