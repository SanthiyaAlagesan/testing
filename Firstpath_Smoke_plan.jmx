            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Future Auth Dates (BeanShell PreProcessor)" enabled="false">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Calendar;

synchronized (this.getClass()) {
    // 1. Persist runCounter across runs (defaults to 1 if not set)
    String counterStr = props.get(&quot;RUN_COUNTER&quot;);
    int runCounter = (counterStr != null) ? Integer.parseInt(counterStr) : 1;

    // 2. Base Start Date: January 1, 2030
    Calendar startCal = Calendar.getInstance();
    startCal.set(Calendar.YEAR, 2030);
    startCal.set(Calendar.MONTH, Calendar.JANUARY);
    startCal.set(Calendar.DAY_OF_MONTH, 1);
    
    // Add 3 months per run counter (Run 1 = Q1, Run 2 = Q2, etc.)
    startCal.add(Calendar.MONTH, (runCounter - 1) * 3);

    // 3. Calculate End Date (Last day of the 3rd month)
    Calendar endCal = (Calendar) startCal.clone();
    endCal.add(Calendar.MONTH, 2); 
    int lastDay = endCal.getActualMaximum(Calendar.DAY_OF_MONTH);
    endCal.set(Calendar.DAY_OF_MONTH, lastDay);

    // 4. Calculate Auth/Schedule Date (15th of the END MONTH of the authorization)
    Calendar authCal = (Calendar) endCal.clone();
    authCal.set(Calendar.DAY_OF_MONTH, 15);

    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
    String startDate = sdf.format(startCal.getTime());
    String endDate = sdf.format(endCal.getTime());
    String treatmentAuthDate = sdf.format(authCal.getTime()); 
    String scheduleDate = treatmentAuthDate; 

    // Save variables for current request body
    vars.put(&quot;startDate&quot;, startDate);
    vars.put(&quot;endDate&quot;, endDate);
    vars.put(&quot;treatmentAuthDate&quot;, treatmentAuthDate);
    vars.put(&quot;scheduleDate&quot;, scheduleDate);

    log.info(&quot;--- [RUN #&quot; + runCounter + &quot;] Start: &quot; + startDate + &quot; | End: &quot; + endDate + &quot; | Schedule Date: &quot; + scheduleDate + &quot; ---&quot;);

    // 5. Increment counter for the NEXT script execution
    props.put(&quot;RUN_COUNTER&quot;, String.valueOf(runCounter + 1));
}</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="Past Auth dates (BeanShell PreProcessor)" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.io.File;

synchronized (this.getClass()) {
    // Define a persistent file to store the counter across JMeter restarts/days
    String counterFileName = &quot;treatment_run_counter.txt&quot;;
    File counterFile = new File(counterFileName);
    int runCounter = 1;

    // 1. Read counter from file if it exists, otherwise check JMeter properties
    if (counterFile.exists()) {
        try {
            // Read file content in BeanShell
            Scanner scanner = new Scanner(counterFile);
            if (scanner.hasNextLine()) {
                String fileContent = scanner.nextLine().trim();
                if (!fileContent.isEmpty()) {
                    runCounter = Integer.parseInt(fileContent);
                }
            }
            scanner.close();
        } catch (Exception e) {
            runCounter = 1;
        }
    } else {
        String currentCounterStr = props.get(&quot;TREATMENT_RUN_COUNTER&quot;);
        if (currentCounterStr != null &amp;&amp; !currentCounterStr.trim().equals(&quot;&quot;)) {
            try {
                runCounter = Integer.parseInt(currentCounterStr.trim());
            } catch (Exception e) {
                runCounter = 1;
            }
        }
    }

    // 2. Base Start Date: Jan 01, 2000
    Calendar startCal = Calendar.getInstance();
    startCal.clear();
    startCal.set(2000, Calendar.JANUARY, 1);

    // 3. Advance start date by 3 months per run counter cycle
    startCal.add(Calendar.MONTH, (runCounter - 1) * 3);

    // 4. Calculate End Date (last day of the 3rd month)
    Calendar endCal = (Calendar) startCal.clone();
    endCal.add(Calendar.MONTH, 2); 
    int lastDay = endCal.getActualMaximum(Calendar.DAY_OF_MONTH);
    endCal.set(Calendar.DAY_OF_MONTH, lastDay);

    // 5. Format dates as yyyy-MM-dd
    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
    String startDate = sdf.format(startCal.getTime());
    String endDate = sdf.format(endCal.getTime());

    // 6. Save variables to local context AND global properties
    vars.put(&quot;startDate&quot;, startDate);
    vars.put(&quot;endDate&quot;, endDate);
    props.put(&quot;SHARED_START_DATE&quot;, startDate); // Shared globally with Session Note script

    // 7. Increment counter and save to file AND properties for the next run
    int nextCounter = runCounter + 1;
    props.put(&quot;TREATMENT_RUN_COUNTER&quot;, String.valueOf(nextCounter));
    
    try {
        // Write counter to file in BeanShell
        FileWriter writer = new FileWriter(counterFile, false);
        writer.write(String.valueOf(nextCounter));
        writer.close();
    } catch (Exception e) {
        log.error(&quot;Could not write counter file: &quot; + e.getMessage());
    }

    log.info(&quot;--- Treatment Run #&quot; + runCounter + &quot; | Start: &quot; + startDate + &quot; | End: &quot; + endDate + &quot; ---&quot;);
}</stringProp>
