&quot;:null,&quot;SkillObjectiveCompletionCriteriaType&quot;:1,&quot;BehaviourObjectiveCompletionCriteriaType&quot;:[],&quot;IsMovedtoNxtAuth&quot;:false,&quot;MeasurementType&quot;:null,&quot;MeasurementNumber&quot;:null}</stringProp>
