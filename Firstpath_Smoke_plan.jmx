          <hashTree>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;
import java.util.Locale;
import java.io.File;
import java.util.Scanner;

synchronized (this.getClass()) {
    String rawStartDate = &quot;&quot;;
    
    // 1. Fetch active startDate from local context, falling back to global property
    rawStartDate = vars.get(&quot;startDate&quot;);
    if (rawStartDate == null || rawStartDate.trim().isEmpty() || rawStartDate.equals(&quot;${startDate}&quot;)) {
        rawStartDate = props.getProperty(&quot;SHARED_START_DATE&quot;);
    }

    // 2. If memory is blank (e.g., fresh JMeter start today), read the persistent counter file directly
    if (rawStartDate == null || rawStartDate.trim().isEmpty() || rawStartDate.equals(&quot;${startDate}&quot;)) {
        File counterFile = new File(&quot;treatment_run_counter.txt&quot;);
        int runCounter = 1;

        if (counterFile.exists()) {
            try {
                Scanner scanner = new Scanner(counterFile);
                if (scanner.hasNextLine()) {
                    String fileContent = scanner.nextLine().trim();
                    if (!fileContent.isEmpty()) {
                        runCounter = Integer.parseInt(fileContent);
                        if (runCounter &gt; 1) {
                            runCounter = runCounter - 1;
                        }
                    }
                }
                scanner.close();
            } catch (Exception e) {
                runCounter = 1;
            }
        }

        // Re-calculate the start date based on the active run counter
        Calendar startCal = Calendar.getInstance();
        startCal.clear();
        startCal.set(2000, Calendar.JANUARY, 1);
        startCal.add(Calendar.MONTH, (runCounter - 1) * 3);
        
        SimpleDateFormat tempSdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
        rawStartDate = tempSdf.format(startCal.getTime());
    }

    rawStartDate = rawStartDate.trim();
    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
    sdf.setLenient(false);

    SimpleDateFormat utcSdf = new SimpleDateFormat(&quot;EEE, dd MMM yyyy HH:mm:ss &apos;GMT&apos;&quot;, Locale.ENGLISH);
    utcSdf.setTimeZone(TimeZone.getTimeZone(&quot;GMT&quot;));

    try {
        // 3. Parse start date and set day to 12th of that active month
        Date parsedDate = sdf.parse(rawStartDate);
        Calendar cal = Calendar.getInstance();
        cal.setTime(parsedDate);
        cal.set(Calendar.DAY_OF_MONTH, 12);

        String sessionDate_Simple = sdf.format(cal.getTime());
        vars.put(&quot;sessionDate_Simple&quot;, sessionDate_Simple);
        vars.put(&quot;sessionDate_12&quot;, sessionDate_Simple);
        vars.put(&quot;sessionDate_12_encoded&quot;, java.net.URLEncoder.encode(sessionDate_Simple, &quot;UTF-8&quot;));

        // ISO format (YYYY-MM-DDTHH:mm:ss.sssZ)
        String sessionDate_ISO = sessionDate_Simple + &quot;T00:00:00.000Z&quot;;
        vars.put(&quot;sessionDate_ISO&quot;, sessionDate_ISO);
        vars.put(&quot;sessionDate_ISO_encoded&quot;, java.net.URLEncoder.encode(sessionDate_ISO, &quot;UTF-8&quot;));
        props.put(&quot;sessionDate_ISO&quot;, sessionDate_ISO);

        // Epoch millisecond format
        long epochTime = cal.getTimeInMillis();
        vars.put(&quot;sessionDate_Epoch&quot;, String.valueOf(epochTime));

        // HTTP / UTC Date format (e.g., Wed, 12 Jan 2000 00:00:00 GMT)
        String sessionDate_UTC = utcSdf.format(cal.getTime());
        vars.put(&quot;sessionDate_UTC&quot;, sessionDate_UTC);
        vars.put(&quot;sessionDate_UTC_encoded&quot;, java.net.URLEncoder.encode(sessionDate_UTC, &quot;UTF-8&quot;));
        props.put(&quot;sessionDate_12&quot;, sessionDate_Simple);

        log.info(&quot;--- SESSION NOTE DATE SUCCESS -&gt; Simple: &quot; + sessionDate_Simple + &quot; | ISO: &quot; + sessionDate_ISO + &quot; | Epoch: &quot; + epochTime + &quot; | UTC: &quot; + sessionDate_UTC + &quot; ---&quot;);

    } catch (Exception e) {
        log.error(&quot;--- SESSION NOTE DATE SCRIPT ERROR: &quot; + e.getMessage() + &quot; ---&quot;);
        
        vars.put(&quot;sessionDate_Simple&quot;, &quot;2000-01-12&quot;);
        vars.put(&quot;sessionDate_12&quot;, &quot;2000-01-12&quot;);
        vars.put(&quot;sessionDate_12_encoded&quot;, &quot;2000-01-12&quot;);
        vars.put(&quot;sessionDate_ISO&quot;, &quot;2000-01-12T00:00:00.000Z&quot;);
        vars.put(&quot;sessionDate_ISO_encoded&quot;, &quot;2000-01-12T00%3A00%3A00.000Z&quot;);
        vars.put(&quot;sessionDate_Epoch&quot;, &quot;947635200000&quot;);
        vars.put(&quot;sessionDate_UTC&quot;, &quot;Wed, 12 Jan 2000 00:00:00 GMT&quot;);
        vars.put(&quot;sessionDate_UTC_encoded&quot;, &quot;Wed%2C+12+Jan+2000+00%3A00%3A00+GMT&quot;);
        props.put(&quot;sessionDate_12&quot;, &quot;2000-01-12&quot;);
    }
}</stringProp>
            </BeanShellPreProcessor>
