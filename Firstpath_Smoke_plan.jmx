            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion" enabled="true">
              <stringProp name="BeanShellAssertion.query">// Skip any sampler containing &quot;Debug Sampler&quot; in its name
if (prev.getSampleLabel().contains(&quot;Debug Sampler&quot;)) {
    return;
}

String responseCode = prev.getResponseCode();

// Ignore samplers that don&apos;t generate standard HTTP response codes (like Debug Samplers)
if (responseCode == null || responseCode.isEmpty()) {
    return;
}

// Log custom failure message for HTTP requests
String responseData = prev.getResponseDataAsString();

if (!&quot;200&quot;.equals(responseCode)) {
    String conciseReason = &quot;&quot;;
    if (responseData.length() &gt; 150) {
        conciseReason = responseData.substring(0, 150) + &quot;...&quot;;
    } else {
        conciseReason = responseData;
    }
    
    String finalMsg = &quot;Failed [Code: &quot; + responseCode + &quot;] - Reason: &quot; + conciseReason;
    prev.setResponseMessage(finalMsg);
    prev.setSuccessful(false);
    Failure = true;
    FailureMessage = finalMsg;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
