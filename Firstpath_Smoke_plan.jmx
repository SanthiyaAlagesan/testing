          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">// 1. Get the token value from the GLOBAL JMeter Property (props)
//    Use the name you set in Step 1: GLOBAL_JWT_Token
def tokenValue = props.get(&quot;GLOBAL_JWT_Token&quot;); 

// 2. Save the value back into a local variable (vars) named &apos;authToken&apos; 
//    so the HTTP Header Manager can use it easily as ${authToken}
vars.put(&quot;authToken&quot;, tokenValue);

// 3. Optional: Log the token value to the JMeter Log for debugging
//    This should now show the actual token string.
log.info(&quot;netrelevel Global Token: &quot; + tokenValue);</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
