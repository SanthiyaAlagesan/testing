            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.Date;
import java.util.TimeZone;
import java.util.Locale;

synchronized (&quot;treatment_date_lock&quot;) {
    // --- 1. HANDLE START DATE ---
    String rawStartDate = vars.get(&quot;startDate&quot;);
    if (rawStartDate == null || rawStartDate.trim().isEmpty() || rawStartDate.contains(&quot;$&quot;)) {
        rawStartDate = props.getProperty(&quot;SHARED_START_DATE&quot;);
    }
    if (rawStartDate == null || rawStartDate.trim().isEmpty() || rawStartDate.contains(&quot;$&quot;)) {
        rawStartDate = &quot;2011-07-10&quot;;
    }

    // --- 2. HANDLE END DATE (Optional secondary date) ---
    String rawEndDate = vars.get(&quot;endDate&quot;);
    if (rawEndDate == null || rawEndDate.trim().isEmpty() || rawEndDate.contains(&quot;$&quot;)) {
        rawEndDate = rawStartDate; // Defaults to start date if not provided
    }

    SimpleDateFormat sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&quot;);
    sdf.setLenient(false);
    
    SimpleDateFormat utcSdf = new SimpleDateFormat(&quot;EEE, dd MMM yyyy HH:mm:ss &apos;GMT&apos;&quot;, Locale.ENGLISH);
    utcSdf.setTimeZone(TimeZone.getTimeZone(&quot;GMT&quot;));

    try {
        // Process Start Date
        Date parsedStartDate = sdf.parse(rawStartDate.trim());
        Calendar startCal = Calendar.getInstance();
        startCal.setTime(parsedStartDate);
        startCal.set(Calendar.DAY_OF_MONTH, 10); // Keep your 10th-day rule if needed

        String sessionDate_Simple = sdf.format(startCal.getTime());
        vars.put(&quot;sessionDate_Simple&quot;, sessionDate_Simple);
        vars.put(&quot;sessionDate_10&quot;, sessionDate_Simple);
        vars.put(&quot;sessionDate_10_encoded&quot;, java.net.URLEncoder.encode(sessionDate_Simple, &quot;UTF-8&quot;));

        String sessionDate_ISO = sessionDate_Simple + &quot;T00:00:00.000Z&quot;;
        vars.put(&quot;sessionDate_ISO&quot;, sessionDate_ISO);
        vars.put(&quot;sessionDate_ISO_encoded&quot;, java.net.URLEncoder.encode(sessionDate_ISO, &quot;UTF-8&quot;));
        props.put(&quot;sessionDate_ISO&quot;, sessionDate_ISO);

        long epochTime = startCal.getTimeInMillis();
        vars.put(&quot;sessionDate_Epoch&quot;, String.valueOf(epochTime));

        String sessionDate_UTC = utcSdf.format(startCal.getTime());
        vars.put(&quot;sessionDate_UTC&quot;, sessionDate_UTC);
        vars.put(&quot;sessionDate_UTC_encoded&quot;, java.net.URLEncoder.encode(sessionDate_UTC, &quot;UTF-8&quot;));

        // Process End Date (UTC Variant)
        Date parsedEndDate = sdf.parse(rawEndDate.trim());
        Calendar endCal = Calendar.getInstance();
        endCal.setTime(parsedEndDate);
        
        String endDate_Simple = sdf.format(endCal.getTime());
        String endDate_UTC = utcSdf.format(endCal.getTime());
        vars.put(&quot;endDate_Simple&quot;, endDate_Simple);
        vars.put(&quot;endDate_UTC&quot;, endDate_UTC);
        vars.put(&quot;endDate_UTC_encoded&quot;, java.net.URLEncoder.encode(endDate_UTC, &quot;UTF-8&quot;));

        log.info(&quot;--- DATE SUCCESS -&gt; Start UTC: &quot; + sessionDate_UTC + &quot; | End UTC: &quot; + endDate_UTC + &quot; ---&quot;);

    } catch (Exception e) {
        log.error(&quot;--- DATE SCRIPT ERROR: &quot; + e.getMessage() + &quot; ---&quot;);
        
        // Fallbacks
        vars.put(&quot;sessionDate_Simple&quot;, &quot;2011-07-10&quot;);
        vars.put(&quot;sessionDate_10&quot;, &quot;2011-07-10&quot;);
        vars.put(&quot;sessionDate_ISO&quot;, &quot;2011-07-10T00:00:00.000Z&quot;);
        vars.put(&quot;sessionDate_10_encoded&quot;, &quot;2011-07-10&quot;);
        vars.put(&quot;sessionDate_ISO_encoded&quot;, &quot;2011-07-10T00%3A00%3A00.000Z&quot;);
        vars.put(&quot;sessionDate_Epoch&quot;, &quot;1310256000000&quot;);
        vars.put(&quot;sessionDate_UTC&quot;, &quot;Sun, 10 Jul 2011 00:00:00 GMT&quot;);
        vars.put(&quot;sessionDate_UTC_encoded&quot;, &quot;Sun%2C+10+Jul+2011+00%3A00%3A00+GMT&quot;);
        
        vars.put(&quot;endDate_Simple&quot;, &quot;2011-07-10&quot;);
        vars.put(&quot;endDate_UTC&quot;, &quot;Sun, 10 Jul 2011 00:00:00 GMT&quot;);
        vars.put(&quot;endDate_UTC_encoded&quot;, &quot;Sun%2C+10+Jul+2011+00%3A00%3A00+GMT&quot;);
    }
}</stringProp>
